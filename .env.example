# PolySimulator API key (Free-tier or Plus-tier key from https://polysimulator.com/api-keys)
POLYSIM_API_KEY=ps_live_your_key_here

# Google Gemini API key (Vertex AI Express AQ.* or AI Studio AIza*)
GEMINI_API_KEY=your_gemini_api_key_here

# Safety mode: true = dry-run (no orders sent), false = live simulation orders
DRY_RUN=true

# Default Gemini model for forecasting
GEMINI_MODEL=gemini-3.5-flash-lite
